{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "color": { "1": "#D9B36C", "2": "#7ED3AE" },
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "color": { "keys": "green", "title": "yellow" },
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "de",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "packages",
    "colors"
  ]
}
